[core]
  excludesfile = ~/.gitignore
  editor = code -w
  trustctime = false
  eol = lf
  autocrlf = input

[user]
  name = Jonas Friedmann
  email = j@frd.mn
  signingkey = 592054EFEE01155264764EC9B6E314FBD713FC95

[merge]
  log = true

[difftool]
  prompt = false
  tool = vimdiff

[mergetool]
  prompt = false

[alias]
  s = status
  ci = "commit -m"
  l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset (%GK) %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  pushup = push --set-upstream origin HEAD
  delete-merged-branches = "!git branch --merged | egrep -v '(^\\*|master|dev)' | xargs echo git branch -d"

[commit]
  gpgsign = true

[github]
  user = frdmn

[init]
  defaultBranch = main
